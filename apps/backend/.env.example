# Copy to `.env` for local development. Never commit `.env`.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Local database started with `npm run db` (embedded PostgreSQL 17, no Docker).
# Runtime uses DATABASE_URL (pooled in production); migrations use DIRECT_URL.
DATABASE_URL=postgresql://kavriel:kavriel@localhost:5433/kavriel
DIRECT_URL=postgresql://kavriel:kavriel@localhost:5433/kavriel

# Secrets: at least 32 random characters each, and different from each other.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
QR_SIGNING_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# QR rotation defaults (per-session values can override the rotation).
QR_DEFAULT_ROTATION_SECONDS=15
QR_GRACE_WINDOWS=1

# Shared out-of-band with teachers; required to register a teacher account.
TEACHER_SIGNUP_CODE=

SCHOOL_TIMEZONE=Asia/Manila
SESSION_EARLY_START_MINUTES=15

# Comma-separated browser origins (Phase 3 admin web). Empty is fine for mobile-only.
CORS_ORIGIN=
RATE_LIMIT_ENABLED=true
