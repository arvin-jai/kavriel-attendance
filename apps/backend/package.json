{
  "name": "@kavriel/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Kavriel attendance REST API (Express + TypeScript + Prisma + PostgreSQL)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "db": "tsx scripts/db.ts start",
    "db:stop": "tsx scripts/db.ts stop",
    "db:reset": "tsx scripts/db.ts reset",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "postinstall": "prisma generate",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "start:prod": "prisma migrate deploy && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@kavriel/shared": "*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "embedded-postgres": "17.10.0-beta.17",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.2"
  }
}
